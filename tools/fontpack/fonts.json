{
  "out_dir": "ui/fonts/gen",
  "scan": ["ui/src", "bridge/src"],
  "extra": "√",
  "charset": "ui/fonts/charset.txt",
  "fonts": [
    { "name": "ct_font_text_18", "path": "third_party/fonts/sarasa-ui-sc/SarasaUiSC-Regular.ttf", "size": 18, "hinting": "native", "cjk": true },
    { "name": "ct_font_text_20", "path": "third_party/fonts/sarasa-ui-sc/SarasaUiSC-Regular.ttf", "size": 20, "hinting": "native", "cjk": true },
    { "name": "ct_font_bold_20", "path": "third_party/fonts/sarasa-ui-sc/SarasaUiSC-SemiBold.ttf", "size": 20, "hinting": "native", "cjk": true },
    { "name": "ct_font_bold_24", "path": "third_party/fonts/sarasa-ui-sc/SarasaUiSC-SemiBold.ttf", "size": 24, "hinting": "native", "cjk": true },
    { "name": "ct_font_mono_18", "path": "third_party/fonts/jetbrains-mono/JetBrainsMono-Medium.ttf", "size": 18, "fallback": "ct_font_text_18" },
    { "name": "ct_font_mono_20", "path": "third_party/fonts/jetbrains-mono/JetBrainsMono-Medium.ttf", "size": 20, "fallback": "ct_font_text_20" },
    { "name": "ct_font_monob_20", "path": "third_party/fonts/jetbrains-mono/JetBrainsMono-ExtraBold.ttf", "size": 20, "fallback": "ct_font_bold_20" },
    { "name": "ct_font_monob_24", "path": "third_party/fonts/jetbrains-mono/JetBrainsMono-ExtraBold.ttf", "size": 24, "fallback": "ct_font_bold_24" }
  ]
}
